# ============================================
# Plantilla de variables de entorno del proyecto.
# Copiar a .env y completar con valores reales locales.
# Este archivo SÍ se sube al repo. El .env real NO.
# ============================================

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# --- Task 23: Base de datos MySQL ---
DB_NAME=ingreso_odontologia
DB_USER=root
DB_PASSWORD=tu_password_local
DB_HOST=localhost
DB_PORT=3306

# CA público de Aiven (lo descarga el equipo desde la consola).
# Vacío en desarrollo local sin SSL. En Render: certs/aiven-ca.pem
DB_SSL_CA=

# True solo para CI/tests. En producción debe ser False (MySQL/Aiven).
USE_SQLITE=False

# ============================================
# Task 31: Proteger datos sensibles del formulario (REQ-08)
# Llave Fernet para el cifrado de campos.
# Generar con en la terminal, Lo que aparezca como llave, lo pegan despues de FIELD_ENCRYPTION_KEY=:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================
FIELD_ENCRYPTION_KEY=genera_tu_propia_llave_con_el_comando_de_arriba
